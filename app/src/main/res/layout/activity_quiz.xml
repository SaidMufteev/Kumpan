<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:paddingTop="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Назад"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:textColor="@color/color_white"
            android:background="@drawable/back_button_bg"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Алко"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            android:textColor="@color/color_text_dark"
            android:gravity="end" />

    </LinearLayout>

    <!-- Счётчик вопросов -->
    <TextView
        android:id="@+id/tvQuestionCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вопрос 1 из 9"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="@color/color_gray"
        android:layout_marginBottom="20dp" />

    <!-- Текст вопроса -->
    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Текст вопроса"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="30dp" />

    <!-- Вариант 1 -->
    <Button
        android:id="@+id/btnOption1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вариант 1"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_white"
        android:textColor="@color/color_text_dark"
        android:padding="16dp"
        android:layout_marginBottom="10dp" />

    <!-- Вариант 2 -->
    <Button
        android:id="@+id/btnOption2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вариант 2"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_white"
        android:textColor="@color/color_text_dark"
        android:padding="16dp"
        android:layout_marginBottom="10dp" />

    <!-- Вариант 3 -->
    <Button
        android:id="@+id/btnOption3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вариант 3"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_white"
        android:textColor="@color/color_text_dark"
        android:padding="16dp"
        android:layout_marginBottom="10dp" />

    <!-- Вариант 4 -->
    <Button
        android:id="@+id/btnOption4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Вариант 4"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_white"
        android:textColor="@color/color_text_dark"
        android:padding="16dp"
        android:layout_marginBottom="20dp" />

    <!-- Растяжка -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Кнопка "Далее" -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Далее"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_light_green"
        android:textColor="@color/color_dark_green"
        android:padding="16dp"
        android:enabled="false" />

</LinearLayout>