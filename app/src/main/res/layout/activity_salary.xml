<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/color_background"
    android:paddingTop="40dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
        <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Назад" android:textSize="16sp" android:textStyle="bold|italic" android:textColor="@color/color_white" android:background="@drawable/back_button_bg" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Мой заработок" android:textSize="22sp" android:textStyle="bold|italic" android:textColor="@color/color_text_dark" android:gravity="end" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_dark" android:padding="20dp" android:layout_marginBottom="20dp">
        <TextView android:id="@+id/tvTotalEarned" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Всего за месяц: 0 руб." android:textSize="20sp" android:textStyle="bold" android:textColor="@color/color_light_green" android:layout_marginBottom="10dp"/>
        <TextView android:id="@+id/tvFirstHalf" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1-15: 0 руб." android:textSize="16sp" android:textColor="@color/color_light_green" />
        <TextView android:id="@+id/tvSecondHalf" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="16-31: 0 руб." android:textSize="16sp" android:textColor="@color/color_light_green" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="История смен:" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/color_text_dark" android:layout_marginBottom="10dp"/>
    <ListView android:id="@+id/listSalary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
</LinearLayout>