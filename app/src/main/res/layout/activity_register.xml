<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:padding="24dp"
    android:gravity="center">

    <!-- Логотип + название -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:layout_marginBottom="30dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_kumpan"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kumpan"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            android:textColor="@color/color_white" />

    </LinearLayout>

    <!-- Приветствие -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добро пожаловать!\nДавайте познакомимся :)"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="20dp" />

    <!-- ДОБАВЛЕНО: Поле ФИО -->
    <EditText
        android:id="@+id/etFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Фамилия и имя (например: Иванов Иван)"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="15dp" />

    <!-- Поле Логин (код) -->
    <EditText
        android:id="@+id/etLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Рабочий код (4 цифры)"
        android:textSize="16sp"
        android:inputType="number"
        android:maxLength="4"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="15dp" />

    <!-- Поле Пароль -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Пароль (4 цифры)"
        android:textSize="16sp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="5dp" />

    <!-- Поле Подтверждение пароля -->
    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Подтвердите пароль"
        android:textSize="16sp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ошибка"
        android:textSize="12sp"
        android:textColor="@color/color_red"
        android:visibility="gone"
        android:layout_marginBottom="15dp" />

    <!-- Кнопка Зарегистрироваться -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Зарегистрироваться"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_light_green"
        android:textColor="@color/color_dark_green"
        android:padding="16dp"
        android:layout_marginBottom="20dp" />

    <!-- Текст "Уже с нами?" -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Уже с нами?"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp" />

    <!-- Кнопка Войти -->
    <Button
        android:id="@+id/btnLoginLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Войти"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_black"
        android:textColor="@color/color_light_green"
        android:padding="16dp" />

</LinearLayout>