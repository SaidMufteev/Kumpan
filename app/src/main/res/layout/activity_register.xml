<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:padding="24dp"
    android:gravity="center">

    <!-- Логотип и название -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_kumpan"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kumpan"
            android:textSize="36sp"
            android:textStyle="bold|italic"
            android:textColor="@color/color_white"
            android:shadowColor="#40000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:letterSpacing="0.03" />

    </LinearLayout>

    <!-- Приветствие -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/register_welcome"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="30dp" />

    <!-- Поле Логин -->
    <EditText
        android:id="@+id/etLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/login_hint"
        android:textSize="16sp"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="15dp" />

    <!-- Поле Пароль -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/password_hint"
        android:textSize="16sp"
        android:inputType="textPassword"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="15dp" />

    <!-- Поле Подтверждение пароля -->
    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/confirm_password_hint"
        android:textSize="16sp"
        android:inputType="textPassword"
        android:padding="16dp"
        android:background="@drawable/edit_text_border"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_gray"
        android:layout_marginBottom="5dp" />

    <TextView
        android:id="@+id/tvConfirmError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пароли не совпадают :("
        android:textSize="12sp"
        android:textColor="@color/color_red"
        android:visibility="gone"
        android:layout_marginBottom="20dp" />

    <!-- Кнопка Зарегистрироваться (зелёная) -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/register_button"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_light_green"
        android:textColor="@color/color_dark_green"
        android:padding="16dp"
        android:layout_marginBottom="30dp" />

    <!-- Текст "Уже с нами?" -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/already_with_us"
        android:textSize="18sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_gravity="center"
        android:layout_marginBottom="15dp" />

    <!-- Кнопка Войти (чёрная) -->
    <Button
        android:id="@+id/btnLoginLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_link"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:backgroundTint="@color/color_black"
        android:textColor="@color/color_light_green"
        android:padding="16dp"
        android:layout_marginBottom="40dp" />

    <!-- Ссылка "Возникли трудности?" -->
    <TextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_password"
        android:textSize="14sp"
        android:textColor="@color/color_text_dark"
        android:layout_gravity="center" />

</LinearLayout>