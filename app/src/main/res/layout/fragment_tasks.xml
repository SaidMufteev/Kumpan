<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:paddingTop="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tasks_title"
        android:textSize="24sp"
        android:textStyle="bold|italic"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="20dp" />

    <ListView
        android:id="@+id/listTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- Блок добавления (только для менеджера) -->
    <LinearLayout
        android:id="@+id/addTaskBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etNewTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Новая задача..."
            android:padding="12dp"
            android:background="@drawable/edit_text_border"
            android:textColor="@color/color_text_dark"
            android:textColorHint="@color/color_gray"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAddTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="24sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_light_green"
            android:textColor="@color/color_dark_green"
            android:minWidth="60dp"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>