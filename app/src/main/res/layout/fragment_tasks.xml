<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:paddingTop="40dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tasks_title"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:textColor="@color/color_text_dark" />

        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="На проверке"
            android:textSize="12sp"
            android:backgroundTint="@color/color_light_green"
            android:textColor="@color/color_dark_green"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarTasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Список задач пуст"
        android:textSize="16sp"
        android:textStyle="italic"
        android:textColor="@color/color_text_dark"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- Кнопка добавления задачи (только для менеджера/шефа) -->
    <Button
        android:id="@+id/btnAddTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Добавить задачу"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/color_light_green"
        android:textColor="@color/color_dark_green"
        android:padding="16dp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
</LinearLayout>