<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kumpan"
        tools:targetApi="31">

        <!-- LoginActivity — стартовая -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity -->
        <activity android:name=".MainActivity" android:exported="false" />

        <!-- RegisterActivity -->
        <activity android:name=".RegisterActivity" android:exported="false" />

        <!-- TtkListActivity -->
        <activity android:name=".TtkListActivity" android:exported="false" />

        <!-- CocktailDetailActivity -->
        <activity android:name=".CocktailDetailActivity" android:exported="false" />

        <!-- DessertDetailActivity -->
        <activity android:name=".DessertDetailActivity" android:exported="false" />

        <!-- SeasonActivity -->
        <activity android:name=".SeasonActivity" android:exported="false" />

        <!-- GrainDetailActivity -->
        <activity android:name=".GrainDetailActivity" android:exported="false" />

        <!-- QuizActivity -->
        <activity android:name=".QuizActivity" android:exported="false" />

        <!-- QuizResultActivity -->
        <activity android:name=".QuizResultActivity" android:exported="false" />

        <!-- EmployeeListActivity -->
        <activity android:name=".EmployeeListActivity" android:exported="false" />

        <!-- Экран управления графиком -->
        <activity android:name=".ScheduleManagerActivity" android:exported="false" />

        <activity android:name=".QuizReviewActivity" android:exported="false" />

        <activity android:name=".SalaryActivity" android:exported="false" />
        <activity android:name=".ActiveShiftsActivity" android:exported="false" />

    </application>
</manifest>